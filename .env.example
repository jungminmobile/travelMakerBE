# PostgreSQL (Docker & Spring Boot local profile)
DB_URL=jdbc:postgresql://localhost:5432/travel_maker
DB_NAME=travel_maker
DB_PORT=5432
DB_USERNAME=travel_maker
DB_PASSWORD=change_me

# Firebase
# 로컬에서는 `gcloud auth application-default login` 또는 `GOOGLE_APPLICATION_CREDENTIALS` 환경변수로 ADC 인증을 설정합니다.
FIREBASE_PROJECT_ID=your-firebase-project-id

# CORS (쉼표로 구분해 여러 Origin 지정 가능)
FRONTEND_ORIGIN=http://localhost:5173
